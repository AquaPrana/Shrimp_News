generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id             String               @id @default(cuid())
  name           String               @default("Shrimp.News Admin")
  email          String               @unique
  password       String
  role           String               @default("super_admin")
  imageUrl       String?
  isActive       Boolean              @default(true)
  sessionVersion Int                  @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       AdminSessionRecord[]
  resetTokens    AdminPasswordReset[]
  loginHistory   AdminLoginAudit[]

  @@index([role])
  @@index([isActive])
}

model AdminSessionRecord {
  id         String    @id @default(cuid())
  adminId    String
  userAgent  String?   @db.Text
  ipAddress  String?
  rememberMe Boolean   @default(false)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
}

model AdminPasswordReset {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
}

model AdminLoginAudit {
  id        String   @id @default(cuid())
  adminId   String?
  email     String
  success   Boolean
  userAgent String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([email, createdAt])
}

model Article {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String   @db.LongText
  excerpt      String?
  imageUrl     String?
  mainCategory String   @default("india")
  category     String
  isPublished  Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isPopular    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mainCategory])
  @@index([category])
  @@index([isPublished, createdAt])
  @@index([isPublished, isFeatured, createdAt])
  @@index([isPublished, isPopular, createdAt])
}

model Subscriber {
  id                   String               @id @default(cuid())
  email                String               @unique
  isActive             Boolean              @default(true)
  subscribedAt         DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  welcomeEmailSent     Boolean              @default(false)
  welcomeEmailSentAt   DateTime?
  lastNewsletterSentAt DateTime?
  unsubscribeToken     String?              @unique @db.VarChar(64)
  createdAt            DateTime             @default(now())
  newsletterDeliveries NewsletterDelivery[]

  @@index([isActive, subscribedAt])
}

model NewsletterDelivery {
  id             String     @id @default(cuid())
  subscriberId   String
  newsletterWeek String     @db.VarChar(10)
  status         String     @default("processing")
  sentAt         DateTime?
  errorMessage   String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  subscriber     Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, newsletterWeek])
  @@index([newsletterWeek, status])
}

model Event {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  shortDescription String?   @db.Text
  description      String?   @db.LongText
  startDate        DateTime
  endDate          DateTime?
  dateLabel        String?
  venue            String
  duration         String?
  category         String
  region           String
  audience         String?   @db.LongText
  imageUrl         String?
  officialWebsite  String?
  status           String    @default("draft")
  isFeatured       Boolean   @default(false)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, displayOrder, startDate])
  @@index([region])
  @@index([category])
}

/**
 * Manually curated market ticker items shown on the homepage.
 */
model TickerItem {
  id            String    @id @default(cuid())
  label         String
  value         String    @default("")
  description   String?   @db.Text
  type          String    @default("market")
  linkUrl       String?
  linkLabel     String?
  imageUrl      String?
  displayOrder  Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  /**
   * Legacy market fields retained additively for rollback/data safety.
   */
  price         Float
  currency      String    @default("INR")
  unit          String    @default("kg")
  changePercent Float?
  direction     String    @default("neutral")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@index([isActive, displayOrder, createdAt])
  @@index([startsAt])
  @@index([endsAt])
}

/**
 * Singleton row for the ticker "Last Updated" label.
 */
model TickerMeta {
  id          String   @id @default("default")
  lastUpdated DateTime
}
